<Window x:Class="BalatonWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalatonWPF"
        mc:Ignorable="d"
        Title="BalatonWPF" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="dtgAdatok" Grid.Row="0" Grid.Column="0" Width="*"/>
        <ComboBox x:Name="cbxValaszt" Grid.Column="1" Grid.Row="0" Margin="10 30 10 10" VerticalAlignment="Top" Height="45"/>
        <StackPanel Grid.Row="0" Grid.Column="2">
            <Button x:Name="btnModosit" Content="Módosít" Margin="10 30 10 10" Height="40" VerticalAlignment="Top"/>
            <Button x:Name="btnMentes" Content="Mentés" Margin="10 10 10 10" Height="30" VerticalAlignment="Top"/>
        </StackPanel>
    </Grid>
</Window>
